# Never commit a real token or secret.
LIARA_API_TOKEN=
SENTINEL_ACCESS_KEY=
LIARA_ENABLE_WRITES=false
LIARA_TEST_PROJECT=
SENTINEL_DATA_DIR=.sentinel-data
# Optional, MUST be configured together. Host must be explicitly allowlisted.
SENTINEL_HEALTH_URL=
SENTINEL_HEALTH_PROJECT=
LIARA_ALLOWED_HEALTH_HOSTS=
SENTINEL_WORKSPACE_ROOT=
