# Copy to deploy/server/app.env, chmod 600; NEVER commit real secrets.
# The Caddy login is separate from this Sentinel operator key.
SENTINEL_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARACTERS
# Optional READ-ONLY Liara token. Do not enable writes on this deployment.
LIARA_API_TOKEN=
# Optional Liara team identifier; use the one from your own account's API page.
LIARA_TEAM_ID=
SENTINEL_CHAT_LLM_ENABLED=false
SENTINEL_LLM_MODEL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_BASE_URL=
# No CLI credentials or arbitrary source workspace should be mounted.
