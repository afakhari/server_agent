# Copy to deploy/server/caddy.env. Never commit passwords or hashes from real accounts.
# Domain must resolve to the VPS and ports 80/443 must reach Caddy.
SENTINEL_DOMAIN=sentinel.example.com
# Caddy only accepts a hash; generate interactively with: caddy hash-password
# Single-quote bcrypt hashes in this env file so Compose does not expand $ variables.
SENTINEL_BASIC_AUTH_HASH='REPLACE_WITH_CADDY_HASH'
